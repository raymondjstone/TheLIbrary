<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables (each produces its own runner host). -->
    <OutputType>Exe</OutputType>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)..\CodeCoverage.runsettings</RunSettingsFilePath>
    <!-- xUnit1051: prefer TestContext.Current.CancellationToken over
         CancellationToken.None. Pure cooperative-cancellation responsiveness
         advice that doesn't matter for these (fast, non-cancellable) tests —
         suppress rather than thread a token through 600+ call sites. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <!-- Microsoft.EntityFrameworkCore.Sqlite pulls in SQLitePCLRaw.lib.e_sqlite3
         2.1.11, which bundles a vulnerable SQLite (GHSA-2m69-gcr7-jv3q, no patched
         2.x release exists). Pinned to the 3.x bundle directly so NuGet's
         nearest-wins resolution picks the newer native SQLite over the transitive
         2.1.11 — test-only dependency, never ships to production. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- A test dependency drags in Newtonsoft.Json 11.0.1, flagged NU1903
         (GHSA-5crp-9r3c-p9vr, ReDoS). Pin the patched 13.x directly so NuGet's
         nearest-wins resolution supersedes the vulnerable transitive — test-only,
         never ships to production. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="xunit.v3" Version="3.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheLIbrary.Server\TheLIbrary.Server.csproj" />
  </ItemGroup>

</Project>
